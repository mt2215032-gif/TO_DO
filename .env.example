# Base URL for the API. Leave empty for same-origin requests (the default —
# correct when the frontend and /api/* functions are served from the same
# Vercel deployment or via `vercel dev`). Set this only if the API is hosted
# on a different origin, e.g. VITE_API_URL=https://your-api.vercel.app
VITE_API_URL=

# Server-side only (no VITE_ prefix — never sent to the browser). Required
# by api/_supabase.js. Get these from your Supabase project's
# Settings -> API page. SUPABASE_SERVICE_ROLE_KEY is a secret: keep it out
# of git, set it in Vercel's Environment Variables UI for production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
